@using ViewExample.Models;
@model Person;

<!DOCTYPE html>
<html>
<head>
    <title> @ViewBag.appTitle</title>
    <meta charset="utf-8" />
    <link href="~/StyleSheet.css" rel="stylesheet" />
</head>
<body>
    <div class="page-content">
    @{
            <div class="box">
                <h3>@Model.Name</h3>
                <table class="table">
                    <tbody>
                        <tr>
                            <td>Gender</td>
                            <td>@Model.Gender</td>
                        </tr>
                        <tr>
                            <td>Date of Birth</td>
                            <td>@Model.DateOfBirth?.ToString("MM/dd/yyyy")</td>
                        </tr>
                    </tbody>
                </table>

            </div>
            <a href="/Home">Back to Persons</a>

    }
    </div>

</body>

</html>
