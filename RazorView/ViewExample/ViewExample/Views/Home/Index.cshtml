@{
    
}

@{
    double? Getage(DateTime? birthDate)
    {
        if(birthDate.HasValue)
        {
            return Math.Round((DateTime.Now - birthDate.Value).TotalDays / 365);
        }
        else
        {
            return null;
        }
    }
}



<!DOCTYPE html>
<html>
    <head>
        <title> @ViewBag.appTitle</title>
        <meta charset="utf-8"/>
        <link href="~/StyleSheet.css" rel="stylesheet"/>
    </head>
    <body>
        <div class="page-content"> 

        @foreach (Person person in ViewBag.Pepole)
        {
                <div class="box float-left w-50">
                    <h3>@person.Name</h3>
                    <table class="table w-100">
                        <tbody>
                            <tr>
                                <td>Gender</td>
                                <td>@person.Gender</td>
                            </tr>
                            <tr>
                                <td>Date of Birth</td>
                                <td>@person.DateOfBirth?.ToString("MM/dd/yyyy")</td>
                            </tr>
                        </tbody>
                    </table>
                <a href="Person-Details/@person.Name">Details</a>
                </div>
        }
        
        </div>
   

    </body>

</html>
